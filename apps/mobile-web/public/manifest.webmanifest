{
  "name": "Spending Tracker",
  "short_name": "Spend",
  "description": "Track spending, debts, and reports with offline access and optional sync.",
  "lang": "en",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "prefer_related_applications": false,
  "background_color": "#f7f3e9",
  "theme_color": "#fffdf8",
  "categories": ["finance", "productivity"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add spending",
      "short_name": "Add",
      "description": "Open the transaction list to record spending.",
      "url": "./#/transactions",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View reports",
      "short_name": "Reports",
      "description": "Open spending reports.",
      "url": "./#/reports",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
