# Copy this file to .env before starting Docker Compose.
# Generate a long, random value; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
API_BASE_URL=http://localhost:4000
EMPTY_ACCOUNT_GRACE_HOURS=12
INACTIVE_ACCOUNT_RETENTION_MONTHS=12
CLEANUP_INTERVAL_HOURS=12
MAX_DEVICE_ACCOUNTS=1000
DEVICE_REGISTRATIONS_PER_WINDOW=10
DEVICE_REGISTRATION_WINDOW_MINUTES=60
TRANSFER_ATTEMPTS_PER_WINDOW=10
TRANSFER_ATTEMPT_WINDOW_MINUTES=15
TRANSFER_TOKEN_LIFETIME_MINUTES=10
DIAGNOSTIC_REPORTS_PER_WINDOW=5
DIAGNOSTIC_WINDOW_MINUTES=60
DIAGNOSTIC_RETENTION_DAYS=30
DIAGNOSTIC_MAX_PER_USER=20
DIAGNOSTIC_MAX_TOTAL=1000
WEBSOCKET_MAX_PER_USER=5
WEBSOCKET_MAX_TOTAL=200
WEBSOCKET_MAX_BUFFERED_BYTES=262144
WEBSOCKET_HEARTBEAT_SECONDS=30
WEBSOCKET_MAX_LIFETIME_HOURS=24
